{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ghl-systems",
      "destination": "/index.html"
    },
    {
      "source": "/ghl-systems/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/demos/hvac-ai-front-desk",
      "destination": "/index.html"
    },
    {
      "source": "/demos/:path*",
      "destination": "/index.html"
    }
  ]
}
